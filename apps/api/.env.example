# =============================================================================
# Nexus AI API — backend environment template (application-local)
# Copy to apps/api/.env and fill in real values. NEVER commit the .env file.
# Placeholders only — no real keys, passwords, or tokens belong anywhere here.
# =============================================================================

# --- Application ---
APP_NAME="Nexus AI API"
ENVIRONMENT="development"
API_HOST="0.0.0.0"
API_PORT=8000
LOG_LEVEL="info"

# --- Database (PostgreSQL; NOT connected yet) ---
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# --- LLM providers (cloud inference is the primary dev path) ---
# Add provider placeholders only when a provider integration begins.
LLM_PROVIDER=""
LLM_API_KEY=""

# --- Optional local runtime (Ollama) ---
# The system must never depend on this being available.
OLLAMA_BASE_URL="http://localhost:11434"